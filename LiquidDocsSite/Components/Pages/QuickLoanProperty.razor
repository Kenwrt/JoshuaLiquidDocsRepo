
@using System.Text
@using LiquidDocsData.Models
@using LiquidDocsData.Enums
@using System.Globalization


@rendermode InteractiveServer

@inject QuickPropertyViewModel vm
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject UserSession Session
@inject QuickPropertyValidator PropertyValidator
@inject PropertyOwnerValidator PropertyOwnerValidator
@inject LienValidator LienValidator



<MudForm Context="contextProperty" Model="@vm.EditingRecord" @ref="@formEditRecord" Validation="@PropertyValidator" ValidationDelay="0">
    <MudGrid GutterSize="3">

        <MudItem md="4">
            <div class="d-flex flex-column gap-2">
                <MudSelect Class="ml-4 mt-10" Style="background-color: white;" T="LiquidDocsData.Enums.Property.Types" Variant="Variant.Outlined" Label="Select Property Type" @bind-Value="vm.EditingRecord.PropertyType" Dense="true">

                    @foreach (var tr in Enum.GetValues<LiquidDocsData.Enums.Property.Types>())
                    {
                        <MudSelectItem Style="background-color: white;" T="LiquidDocsData.Enums.Property.Types" Value="tr">@tr.GetDescription()</MudSelectItem>
                    }

                </MudSelect>

                <MudSwitch Class="pl-4 mb-4 mt-4" T="bool" @bind-Value="vm.EditingRecord.IsOwnerOccupied" Color="Color.Primary" Label="Is Owner Occupied" />
                <MudTextField Class="pl-4" Style="background-color: white;" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.LegalDescription" Label="Description" Required="true" />


                <AddressCompleteMap OnAddressChange="OnAddressComplete" Row="false" MultipleAddress="false" AddressList="@addresDTOList" />



            </div>
        </MudItem>
        <MudItem md="4">
            <div class="d-flex flex-column gap-2">
                <MudTextField Class="pl-4 mt-10 mr-5" Style="background-color: white;" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.ParcelNumber" Label="Parcel Number" Required="false" />

                <MudNumericField Class="pl-4 mr-5" Style="background-color: white;" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="$" Culture="CultureInfo.InvariantCulture"
                                 Format="N2" @bind-Value="vm.EditingRecord.EstimatedValue" Label="Estimated Value" Variant="Variant.Outlined" Step=".2M" />

                <MudDatePicker Class="pl-4 mr-5" Style="background-color: white;" Label="Maturity Date" Editable="true" @bind-Date="vm.EditingRecord.LastAppraisalDate" Mask="@(new DateMask("00-00-0000"))" DateFormat="MM-dd-yyyy" Placeholder="mm-dd-yyyy" Variant="Variant.Outlined" />

                <MudNumericField Class="pl-4 mr-5" Style="background-color: white;" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="$" Culture="CultureInfo.InvariantCulture"
                                 Format="N2" @bind-Value="vm.EditingRecord.MinimumReleasePrice" Label="Minumum Release Price" Variant="Variant.Outlined" Step=".2M" />


                <MudNumericField Class="pl-4 mr-5" Style="background-color: white;" HideSpinButtons="true" Culture="CultureInfo.InvariantCulture"
                                 Format="N0" @bind-Value="vm.EditingRecord.SquareFootage" Label="Square Footage" Variant="Variant.Outlined" />

            </div>
        </MudItem>
        <MudItem md="4">
            <div class="d-flex flex-column gap-2">
                <MudGrid>
                    <MudItem xs="12" md="12">
                        <MudText Class="pl-4 mt-6" Typo="Typo.subtitle1">Property Owner(s): @vm.RecordOwnerList.Count </MudText>
                        <MudTable Class="ml-4 mr-5" Style="background-color: #FCFCFC;" Items="vm.RecordOwnerList" Context="contextOwner" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedOwnerRecord" RowClick="OnSelectedOwnerRecord">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                                <MudTh>Address</MudTh>
                                <MudTh>Ownership</MudTh>
                                <MudTh></MudTh>
                                <MudTh></MudTh>
                                <MudTh>
                                    <MudButton Class="pl-4 rounded-4" Disabled=@AddOwnerButtonDisabled Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="AddOwnerButton">Add Owner</MudButton>
                                </MudTh>

                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@contextOwner.EntityName</MudTd>
                                <MudTd DataLabel="Address">@contextOwner.FullAddress</MudTd>
                                <MudTd DataLabel="Ownership">@contextOwner.PercentageOfOwnership</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Info"
                                                   OnClick="@(() => OnSelectedOwnerRecord(contextOwner))" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Color="Color.Secondary" Class="pa-4">
                                    🚫 No Active Property Owners Found. Please add!
                                </MudText>
                            </NoRecordsContent>
                        </MudTable>

                        @if (AddEditOwner)
                        {
                            <MudForm Context="contextOwn" Model="@vm.EditingOwnerRecord" @ref="@formOwner" Validation="@PropertyOwnerValidator" ValidationDelay="0">


                                <MudGrid Class="mt-2">
                                    <MudItem md="6">
                                        <div class="d-flex flex-column gap-2">
                                            <MudTextField Class="pl-4" Variant="Variant.Outlined" Style="background-color: white;" @bind-Value="vm.EditingOwnerRecord.EntityName" Label="EntityName" Required="true" />
                                            <MudTextField Class="pl-4" Variant="Variant.Outlined" Style="background-color: white;" @bind-Value="vm.EditingOwnerRecord.StreetAddress" Label="Street Address" Required="true" />
                                            <MudTextField Label="Contact Phone" Class="pl-4" Style="background-color: white;" Variant="Variant.Outlined" For="@(() => vm.EditingOwnerRecord.ContactPhoneNumber)"
                                                          @bind-Value="vm.EditingOwnerRecord.ContactPhoneNumber"
                                                          Mask="@(new PatternMask("(000)000-0000"))"
                                                          Placeholder="(___) ___-____"
                                                          Required="true"
                                                          Immediate="true" />

                                            <MudNumericField Class="pl-4" HideSpinButtons="true" Style="background-color: white;" Adornment="Adornment.End" AdornmentText="%" Culture="CultureInfo.InvariantCulture"
                                                             Format="N2" @bind-Value="vm.EditingOwnerRecord.PercentageOfOwnership" Label="Minumum Release Price" Variant="Variant.Outlined" />

                                            <MudStack Row="true" Spacing="10" Class="mt-4 mb-10">
                                                <MudButton Class="ml-10" Type="Submit" OnClick="HandleOwnerSubmit" Color="Color.Success" Variant="Variant.Filled">@(vm.SelectedOwnerRecord == null ? "Add" : "Save")</MudButton>
                                                @if (vm.SelectedOwnerRecord != null)
                                                {
                                                    <MudButton Class="ml-10" OnClick="DeleteOwnerRecord" Color="Color.Error" Variant="Variant.Filled">Delete</MudButton>
                                                }
                                                <MudButton OnClick="ClearOwnerSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                                            </MudStack>
                                        </div>
                                    </MudItem>

                                </MudGrid>
                            </MudForm>

                        }
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" md="12">
                        <MudText Class="pl-4" Typo="Typo.subtitle1">Property Lein(s): @vm.RecordLienList.Count </MudText>
                        <MudTable Class="ml-4 mr-5" Style="background-color: #FCFCFC;" Items="vm.RecordLienList" Context="contextLien" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedLienRecord" RowClick="OnSelectedLienRecord">
                            <HeaderContent>
                                <MudTh>Description</MudTh>
                                <MudTh>Lien Postion</MudTh>
                                <MudTh>Lien Status</MudTh>
                                <MudTh></MudTh>
                                <MudTh>
                                    <MudButton Class="pl-4 rounded-4" Disabled=@AddLienButtonDisabled Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="AddLienButton">Add Lien</MudButton>
                                </MudTh>

                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Description">@contextLien.Description</MudTd>
                                <MudTd DataLabel="Lien Postion">@contextLien.LienPosition</MudTd>



                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Info"
                                                   OnClick="@(() => OnSelectedLienRecord(contextLien))" />
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Color="Color.Secondary" Class="pa-4">
                                    🚫 No Active Liens Found. Please add!
                                </MudText>
                            </NoRecordsContent>
                        </MudTable>

                        @if (AddEditLien)
                        {
                            <MudForm Context="contextL" Model="@vm.EditingLienRecord" @ref="@formLien" Validation="@LienValidator" ValidationDelay="0">

                                <MudGrid Class="mt-2">
                                    <MudItem md="6">
                                        <div class="d-flex flex-column gap-2">
                                            <MudTextField Class="pl-4" Variant="Variant.Outlined" Style="background-color: white;" @bind-Value="vm.EditingLienRecord.Description" Label="Description" Required="true" />
                                            <MudSelect Class="ml-4" Style="background-color: white;" T="LiquidDocsData.Enums.Lien.Positions" Variant="Variant.Outlined" Label="Select Lien Postion" @bind-Value="vm.EditingLienRecord.LienPosition" Dense="true">

                                                @foreach (var lt in Enum.GetValues<LiquidDocsData.Enums.Lien.Positions>())
                                                {
                                                    <MudSelectItem T="LiquidDocsData.Enums.Lien.Positions" Style="background-color: white;" Value="lt">@lt.GetDescription()</MudSelectItem>
                                                }

                                            </MudSelect>


                                            <MudStack Row="true" Spacing="5" Class="mt-2 mb-10">
                                                <MudButton Class="ml-10" Type="Submit" OnClick="HandleLienSubmit" Color="Color.Success" Variant="Variant.Filled">@(vm.SelectedLienRecord == null ? "Add" : "Save")</MudButton>
                                                @if (vm.SelectedLienRecord != null)
                                                {
                                                    <MudButton Class="ml-10" OnClick="DeleteLienRecord" Color="Color.Error" Variant="Variant.Filled">Delete</MudButton>
                                                }
                                                <MudButton OnClick="ClearLienSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                                            </MudStack>
                                        </div>
                                    </MudItem>

                                </MudGrid>
                            </MudForm>

                        }
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="5" Class="mt-4">
                    <MudSwitch Class="pl-4" T="bool" @bind-Value="vm.EditingRecord.IsActive" Color="Color.Primary" Label="Active" />
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="ml-20 mb-15">
                    <MudButton Class="pl-4 mr-15" Type="Submit" OnClick="HandleSubmit" Color="Color.Success" Variant="Variant.Filled"> @(vm.SelectedRecord == null ? "Add" : "Save")</MudButton>
                    @if (vm.SelectedRecord != null)
                    {
                        <MudButton Class="pl-4 mr-15" OnClick="DeleteRecord" Color="Color.Error" Variant="Variant.Filled">Delete</MudButton>
                    }
                    <MudButton Class="pl-4" OnClick="ClearSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                </MudStack>
            </div>
        </MudItem>

    </MudGrid>
</MudForm>


@code
{
    [Parameter] public EventCallback OnComplete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool AllowRecordEdit { get; set; } = false;

    private bool AddEdit = false;
    private bool AddEditOwner = false;
    private bool AddEditLien = false;
    private MudForm formEditRecord;
    private MudForm formLien;
    private MudForm formOwner;
    private List<AddressDTO> addresDTOList = new();

    private bool AddOwnerButtonDisabled = false;

    private bool AddLienButtonDisabled = false;

    private bool AddButtonDisabled = false;

    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        if (vm.EditingRecord is null)
        {
            vm.InitializeRecordCommand.Execute(null);
        }
        else
        {
            if (!String.IsNullOrEmpty(vm.EditingRecord.FullAddress))
            {
                AddressDTO dto = new()
                {
                    FullAddress = vm.EditingRecord.FullAddress,
                    StreetAddress = vm.EditingRecord.StreetAddress,
                    City = vm.EditingRecord.City,
                    State = vm.EditingRecord.State,
                    ZipCode = vm.EditingRecord.ZipCode,
                    County = vm.EditingRecord.County,
                    Country = vm.EditingRecord.Country,
                    Lat = vm.EditingRecord.Lat,    
                    Lng = vm.EditingRecord.Lng    
                   
                };
                addresDTOList.Add(dto);
            }
        }

       
    }

    private async Task HandleSubmit()
    {
        await formEditRecord.Validate();

        if (!formEditRecord.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {

            if (vm.SelectedRecord is null)
            {
                vm.AddRecordCommand.Execute(null);
            }
            else
            {
                vm.EditRecordCommand.Execute(null);

                NavigationManager.NavigateTo("/propertyList");
            }

            AddEdit = false;
            AddButtonDisabled = false;
        }
    }

    private async Task HandleLienSubmit()
    {

        await formLien.Validate();

        if (!formLien.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {

            if (vm.SelectedLienRecord is null)
            {
                vm.AddLienRecordCommand.Execute(null);
                await OnComplete.InvokeAsync(vm.EditingRecord);

                vm.EditingRecord = new LiquidDocsData.Models.PropertyRecord();
            }
            else
            {
                vm.EditLienRecordCommand.Execute(null);
                await OnComplete.InvokeAsync(vm.EditingRecord);

                vm.EditingRecord = new LiquidDocsData.Models.PropertyRecord();
            }

            AddEditLien = false;
            AddLienButtonDisabled = false;
        }

    }

    private async Task HandleOwnerSubmit()
    {
        await formOwner.Validate();

        if (!formOwner.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {

            if (vm.SelectedOwnerRecord is null)
            {
                vm.AddOwnerRecordCommand.Execute(null);
            }
            else
            {
                vm.EditOwnerRecordCommand.Execute(null);
            }

            AddEditOwner = false;
            AddOwnerButtonDisabled = false;

            await vm.InitializeRecordCommand.ExecuteAsync(null);
        }
    }

    private void DeleteRecord()
    {
        vm.DeleteRecordCommand.Execute(null);
        AddEdit = false;
    }

    private void DeleteLienRecord()
    {
        vm.DeleteLienRecordCommand.Execute(null);
        AddEditLien = false;
    }

    private void DeleteOwnerRecord()
    {
        vm.DeleteOwnerRecordCommand.Execute(null);
        AddEditOwner = false;
    }


    private void ClearSelection()
    {
        vm.ClearSelectionCommand.Execute(null);
    }

    private void ClearLienSelection()
    {
        vm.ClearLienSelectionCommand.Execute(null);
    }

    private void ClearOwnerSelection()
    {
        vm.ClearOwnerSelectionCommand.Execute(null);
    }

    private void AddButton()
    {
        vm.EditingRecord = new LiquidDocsData.Models.PropertyRecord();
        vm.EditingRecord.Id = Guid.NewGuid();
        vm.EditingRecord.UserId = Guid.Parse(Session.UserId);

        AddEdit = true;
        AddButtonDisabled = true;
    }

    private void AddLienButton()
    {
        vm.EditingLienRecord = new LiquidDocsData.Models.Lien();
        vm.EditingLienRecord.Id = Guid.NewGuid();
        vm.EditingLienRecord.PropertyId = vm.EditingRecord.Id;
        vm.EditingLienRecord.UserId = vm.EditingRecord.UserId;

        AddEditLien = true;
        AddLienButtonDisabled = true;

    }

    private void AddOwnerButton()
    {
        vm.EditingOwnerRecord = new LiquidDocsData.Models.PropertyOwner();
        vm.EditingOwnerRecord.Id = Guid.NewGuid();
        vm.EditingOwnerRecord.propertyId = vm.EditingRecord.Id;
        vm.EditingOwnerRecord.UserId = vm.EditingRecord.UserId;

        AddEditOwner = true;
        AddOwnerButtonDisabled = true;

    }

    private void OnSelectedRecord(LiquidDocsData.Models.PropertyRecord property)
    {
        if (property is not null) vm.SelectRecordCommand.Execute(property);
        AddEdit = true;
    }

    private void OnSelectedLienRecord(LiquidDocsData.Models.Lien sa)
    {
        if (sa is not null) vm.SelectLienRecordCommand.Execute(sa);

        AddEditLien = true;
    }

    private void OnSelectedOwnerRecord(LiquidDocsData.Models.PropertyOwner sa)
    {
        if (sa is not null) vm.SelectOwnerRecordCommand.Execute(sa);

        AddEditOwner = true;
    }

    private void OnAddressComplete(List<AddressDTO> addressList)
    {
        if (addressList == null || addressList.Count == 0)
        {
            vm.EditingRecord.FullAddress = string.Empty;
            vm.EditingRecord.StreetAddress = string.Empty;
            vm.EditingRecord.City = string.Empty;
            vm.EditingRecord.ZipCode = string.Empty;
            vm.EditingRecord.County = string.Empty;
            vm.EditingRecord.Country = string.Empty;
        }
        else
        {
            var addressDTO = addressList.FirstOrDefault();

            vm.EditingRecord.FullAddress = addressDTO.FullAddress;
            vm.EditingRecord.StreetAddress = addressDTO.StreetAddress;
            vm.EditingRecord.State = addressDTO.State;
            vm.EditingRecord.City = addressDTO.City;
            vm.EditingRecord.ZipCode = addressDTO.ZipCode;
            vm.EditingRecord.County = addressDTO.County;
            vm.EditingRecord.Country = addressDTO.Country;
            vm.EditingRecord.Lat = addressDTO.Lat;
            vm.EditingRecord.Lng = addressDTO.Lng;   
        }

        //vm.EditRecordCommand.Execute(null);
    }

    private async Task Complete()
    {
        await OnComplete.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }



}
