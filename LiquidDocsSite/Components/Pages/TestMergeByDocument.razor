@page "/testmergebydocument"

@using Microsoft.AspNetCore.Components.Forms


@inject IWebHostEnvironment Env
@inject TestMergeViewModel vm

<h3>Test Templates</h3>

<MudSelect Class="ml-4 mt-7" T="LiquidDocsData.Models.Document" Style="background-color: white;" Variant="Variant.Outlined" Label="Select Document" @bind-Value="vm.SelectedDocument" Dense="true">

    @foreach (var doc in vm.DocumentList)
    {
        <MudSelectItem Style="background-color: white;" T="LiquidDocsData.Models.Document" Value="doc">@doc.Name</MudSelectItem>
    }

</MudSelect>


<MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-2 mb-10">
    <MudItem md="3">
        <MudButton Class="" Type="Submit" OnClick="OnMergeDocumentAsync" Color="Color.Success" Variant="Variant.Filled">Merge Document</MudButton>
    </MudItem>
    <MudItem md="3">
        <MudButton Class="" OnClick="OnClearSelectionAsync" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
    </MudItem>
</MudGrid>



@code {
  

    protected override async Task OnInitializedAsync()
    {
       

    }
    
    private async Task OnMergeDocumentAsync()
    {
        await vm.MergeDocumentCommand.ExecuteAsync(null);


    }

    private async Task OnClearSelectionAsync()
    {
        vm.ClearSelectionCommand.Execute(null);
        
    }
}