@page "/akaalias"

@using System.Text;
@using LiquidDocsData.Models;
@using System.Globalization;
@using System.Collections.ObjectModel;
@using LiquidDocsData.Models.MergeDTOs;

@rendermode InteractiveServer
@inject AkaViewModel vm
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AliasValidator AliasValidator
@inject UserSession Session

@if (!String.IsNullOrEmpty(searchString))
{
    <MudText class="pl-4" Typo="Typo.h6">Existing Alias Names</MudText>
    <MudTable Items="@SearchReload()" Context="aliasContext" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedRecord" @ref="searchTable" RowClick="OnSelectedAlias" T="LiquidDocsData.Models.AkaName">
        <ToolBarContent>
            <MudTextField T="string" Immediate="true" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="Search for Existing Borrowers" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="pa-4 mt-5"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Also Known As</MudTh>
            <MudTh>Add</MudTh>
            <MudTh>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Class="mud-link"
                           OnClick="SearchBackAsync">
                    Back
                </MudButton>
            </MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@aliasContext.Name</MudTd>
            <MudTd DataLabel="Also Known As">@aliasContext.AlsoKnownAs</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => AddRecordForEdit(aliasContext))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Color="Color.Secondary" Class="pa-4">
                🚫 No Active Alias Names Found!
            </MudText>
        </NoRecordsContent>
    </MudTable>
}
else
{
    @if (displayAliasList)
    {

        <MudGrid>

            <MudItem xs="12" md="12">

                <MudText Class="pl-2 ml-4" Typo="Typo.subtitle1">Alias: @vm.RecordList.Count </MudText>

                <MudTable Class="ml-4 mr-5" Style="background-color: #FCFCFC;" Items="vm.RecordList" Context="contextAlias" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedRecord" RowClick="OnSelectedRecord">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Alias</MudTh>
                        <MudTh HeaderCellClass="text-right">
                            <MudButton Class="pl-4 rounded-4" Disabled=@AddButtonDisabled Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="AddButton">Add Names</MudButton>
                        </MudTh>

                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Name">@contextAlias.Name</MudTd>
                        <MudTd DataLabel="Alias">@contextAlias.AlsoKnownAs</MudTd>

                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(() => OnSelectedRecord(contextAlias))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Info" OnClick="@(() => DeleteRecordAsync(contextAlias))" />
                        </MudTd>
                        
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary" Class="pa-4">
                            🚫 No Active Alias Names Found. Please add!
                        </MudText>
                    </NoRecordsContent>

                </MudTable>

            </MudItem>

        </MudGrid>

    }
    else
    {
        <MudGrid>

            <MudItem md="12">

                <MudTextField T="string" Immediate="true" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="Search for Existing Alias Names" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="pa-2"></MudTextField>

                <MudForm Context="contextAlias" Model="@vm.EditingRecord" @ref="@form" Validation="@AliasValidator" ValidationDelay="0">

                    <MudGrid>

                        <MudItem md="4">

                            <div class="d-flex flex-column gap-2">


                                <MudTextField Class="ml-4" Style="background-color: white;" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.Name" For="@(() => vm.EditingRecord.Name)" Label="Name" Required="true" />

                                <MudTextField Class="pl-4" Style="background-color: white;" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.AlsoKnownAs" Label="Also Known As" Required="false" />

                                <MudStack Row="true" Spacing="10" Class="mt-4 mb-10">
                                    <MudButton Class="ml-10" Type="Submit" OnClick="HandleSubmit" Color="Color.Success" Variant="Variant.Filled">@(vm.SelectedRecord == null ? "Add" : "Save")</MudButton>
                                    <MudButton OnClick="ClearSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                                </MudStack>

                            </div>

                        </MudItem>

                    </MudGrid>

                </MudForm>

            </MudItem>

        </MudGrid>
    }
}



@code
{

    [Parameter] public EventCallback<List<LiquidDocsData.Models.AkaName>> OnAliasComplete { get; set; }
    [Parameter] public EventCallback OnAliasCanceled { get; set; }
    [Parameter] public List<LiquidDocsData.Models.AkaName> AliasList { get; set; }

    public MudTable<LiquidDocsData.Models.AkaName> listTable = null;

    private MudTable<LiquidDocsData.Models.AkaName> searchTable = new();

    private MudForm form;

    private bool displayAliasList = false;
    private bool AddButtonDisabled = false;

    private List<LiquidDocsData.Models.AkaName> searchList = new();


    private string searchString = "";
    private string _search = "";
    private string emailPattern = @"^[\w\-\.]+@([\w\-]+\.)+[\w\-]{2,4}$";
    private string ssnMask = "000-00-0000";


    private int editingIndex = -1;

    protected override async Task OnInitializedAsync()
    {
        if (vm.EditingRecord is null) vm.InitializeRecordCommand.Execute(null);

        vm.RecordList = AliasList is not null ? new ObservableCollection<LiquidDocsData.Models.AkaName>(AliasList) : new ObservableCollection<LiquidDocsData.Models.AkaName>();

        displayAliasList = true;
    }

    private async Task HandleSubmit()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {
            if (!vm.RecordList.Any(x => x.Id == vm.EditingRecord.Id))
            {

                if (!vm.RecordList.Any(x => x.Name == vm.EditingRecord.Name))
                {
                    vm.AddRecordCommand.Execute(null);

                    await OnAliasComplete.InvokeAsync(vm.RecordList.ToList());

                }
                else
                {
                    Snackbar.Add("A Duplicate Name can exists.", Severity.Error);
                    return;
                }
            }
            else
            {
                vm.EditRecordCommand.Execute(null);

                await OnAliasComplete.InvokeAsync(vm.RecordList.ToList());

            }

            displayAliasList = true;

            StateHasChanged();

            AddButtonDisabled = false;
        }
    }

    private async Task OnSearchAsync(string s)
    {
        searchString = s;

        searchTable.ReloadServerData();
    }

    private async Task SearchBackAsync()
    {
        searchString = "";
    }

    private IEnumerable<LiquidDocsData.Models.AkaName> SearchReload()
    {
        searchList = vm.RecordList.Where(element =>
        {
            if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;

            return false;

        }).ToList();

        int totalItems = searchList.Count();

        IEnumerable<LiquidDocsData.Models.AkaName> pagedData = searchList;

        return pagedData;
    }

    private async Task DeleteRecordAsync(LiquidDocsData.Models.AkaName r)
    {
        vm.RecordList.Remove(r);

        vm.ClearSelectionCommand.Execute(null);


        displayAliasList = true;


        await OnAliasComplete.InvokeAsync(vm.RecordList.ToList());

        StateHasChanged();
    }

    private void ClearSelection()
    {
        vm.ClearSelectionCommand.Execute(null);
        StateHasChanged();
    }

    private void AddRecordForEdit(LiquidDocsData.Models.AkaName r)
    {
        vm.EditingRecord = r;

        searchString = "";

        AddButtonDisabled = true;

        StateHasChanged();
    }

    private void AddButton()
    {
        vm.AddButtonCommand.Execute(null);

        AddButtonDisabled = false;

        displayAliasList = false;
    }

    private void AddAdditionalButton()
    {
        vm.AddButtonCommand.Execute(null);

        AddButtonDisabled = true;

        displayAliasList = false;
    }

    private void OnSelectedRecord(LiquidDocsData.Models.AkaName r)
    {

        if (r is not null) vm.SelectRecordCommand.Execute(r);

        displayAliasList = false;

    }

    private async Task EditRecordAsync(LiquidDocsData.Models.AkaName r)
    {
        OnSelectedRecord(r);

        displayAliasList = false;

        StateHasChanged();

    }

    private void CancelEdit()
    {
        editingIndex = -1;

        StateHasChanged();
    }





}