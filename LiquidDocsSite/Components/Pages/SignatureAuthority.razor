
@using System.Text;
@using LiquidDocsData.Models;
@using System.Globalization;
@using System.Collections.ObjectModel;
@using LiquidDocsData.Models.MergeDTOs;

@rendermode InteractiveServer
@inject SigningAuthorityViewModel vm
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject SigningAuthorityValidator SigningAuthorityValidator
@inject UserSession Session

@if (!String.IsNullOrEmpty(searchString))
{
    <MudGrid>

        <MudItem xs="12" md="12">
            <MudText class="pl-4 mt-5" Typo="Typo.h6">Existing Alias Names</MudText>
            <MudTable Items="@SearchReload()" Context="ContextSign" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedRecord" @ref="searchTable" RowClick="OnSelectedAlias" T="LiquidDocsData.Models.SigningAuthority">
                <ToolBarContent>
                    <MudTextField T="string" Immediate="true" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="Search for Existing Signatories" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="pa-4 mt-5"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Add</MudTh>
                    <MudTh>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Class="mud-link"
                                   OnClick="SearchBackAsync">
                            Back
                        </MudButton>
                    </MudTh>

                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@ContextSign.Name</MudTd>
                    <MudTd DataLabel="Title">@ContextSign.Title</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => AddRecordForEdit(ContextSign))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary" Class="pa-4">
                        🚫 No Active Signatories Found!
                    </MudText>
                </NoRecordsContent>

            </MudTable>

        </MudItem>

    </MudGrid>
}
else
{
    @if (displaySigningAuthorityList)
    {
        <MudGrid>

            <MudItem xs="12" md="12">
                <MudText Class="pl-4 ml-4" Typo="Typo.subtitle1">Signing Authorities: @vm.RecordList.Count </MudText>
                <MudTable Class="ml-4 mr-5" Style="background-color: #FCFCFC;" Items="vm.RecordList" Context="context" Hover="true" Bordered="true" Dense="true" @bind-SelectedItem="vm.SelectedRecord" RowClick="OnSelectedRecord">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh HeaderCellClass="text-right">
                            <MudButton Class="pl-4 rounded-4" Disabled=@AddButtonDisabled Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="AddButton">Add</MudButton>
                            

                        </MudTh>

                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Info"
                                           OnClick="@(() => OnSelectedRecord(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Info" OnClick="@(() => DeleteRecordAsync(context))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary" Class="pa-4">
                            🚫 No Active Owner Assignments!
                        </MudText>
                    </NoRecordsContent>

                </MudTable>

            </MudItem>

        </MudGrid>
    }
    else
    {
        <MudGrid>

            <MudItem xs="12" md="12">

                <MudTextField T="string" Immediate="true" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="Search for Existing Singing Authority" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="pa-2"></MudTextField>

                <MudForm Context="contextESA" Model="@vm.EditingRecord" @ref="@form" Validation="@SigningAuthorityValidator" ValidationDelay="0">
                    <MudGrid Class="mt-2">
                        <MudItem md="6">
                            <div class="d-flex flex-column gap-2">
                                <MudTextField Class="pl-4" Variant="Variant.Outlined" Style="background-color: white;" @bind-Value="vm.EditingRecord.Name" Label="Name" Required="true" />
                                <MudTextField Class="pl-4" Variant="Variant.Outlined" Style="background-color: white;" @bind-Value="vm.EditingRecord.Title" Label="Title" Required="true" />
                                <MudTextField Class="pl-4" Label="Phone Number" Style="background-color: white;" Variant="Variant.Outlined"
                                              @bind-Value="vm.EditingRecord.PhoneNumber"
                                              Mask="@(new PatternMask("(000)000-0000"))"
                                              Placeholder="(___) ___-____"
                                              Required="true"
                                              Immediate="true" />

                                <MudStack Row="true" Spacing="10" Class="mt-4 mb-10">
                                    <MudButton Class="ml-10" Type="Submit" OnClick="HandleSubmit" Color="Color.Success" Variant="Variant.Filled">@(vm.SelectedRecord == null ? "Add" : "Save")</MudButton>
                                   
                                    <MudButton OnClick="ClearSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                                </MudStack>
                            </div>
                        </MudItem>

                    </MudGrid>

                </MudForm>

            </MudItem>

        </MudGrid>
    }
}


@code
{

    [Parameter] public EventCallback<List<LiquidDocsData.Models.SigningAuthority>> OnSigningAuthorityComplete { get; set; }
    [Parameter] public EventCallback OnSigningAuthorityCanceled { get; set; }
    [Parameter] public List<LiquidDocsData.Models.SigningAuthority> SigningAuthorityList { get; set; }
            
    public MudTable<LiquidDocsData.Models.SigningAuthority> listTable = null;

    private MudTable<LiquidDocsData.Models.SigningAuthority> searchTable = new();

    private MudForm form;

    private bool displaySigningAuthorityList = false;
    private bool AddButtonDisabled = false;

    private List<LiquidDocsData.Models.SigningAuthority> searchList = new();


    private string searchString = "";
    private string _search = "";
    private string emailPattern = @"^[\w\-\.]+@([\w\-]+\.)+[\w\-]{2,4}$";
    private string ssnMask = "000-00-0000";


    private int editingIndex = -1;

    protected override async Task OnInitializedAsync()
    {
        if (vm.EditingRecord is null) vm.InitializeRecordCommand.Execute(null);

        vm.RecordList = SigningAuthorityList is not null ? new ObservableCollection<LiquidDocsData.Models.SigningAuthority>(SigningAuthorityList) : new ObservableCollection<LiquidDocsData.Models.SigningAuthority>();


        displaySigningAuthorityList = true;
    }

    private async Task HandleSubmit()
    {
        await form.Validate();

        if (!form.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {
            if (!vm.RecordList.Any(x => x.Id == vm.EditingRecord.Id))
            {

                if (!vm.RecordList.Any(x => x.Name == vm.EditingRecord.Name))
                {
                    vm.AddRecordCommand.Execute(null);

                    await OnSigningAuthorityComplete.InvokeAsync(vm.RecordList.ToList());

                }
                else
                {
                    Snackbar.Add("A Duplicate Name can exists.", Severity.Error);
                    return;
                }
            }
            else
            {
                vm.EditRecordCommand.Execute(null);

                await OnSigningAuthorityComplete.InvokeAsync(vm.RecordList.ToList());

            }

            displaySigningAuthorityList = true;

            StateHasChanged();

            AddButtonDisabled = false;
        }
    }

    private async Task OnSearchAsync(string s)
    {
        searchString = s;

        searchTable.ReloadServerData();
    }

    private async Task SearchBackAsync()
    {
        searchString = "";
    }

    private IEnumerable<LiquidDocsData.Models.SigningAuthority> SearchReload()
    {
        searchList = vm.RecordList.Where(element =>
        {
            if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;

            return false;

        }).ToList();

        int totalItems = searchList.Count();

        IEnumerable<LiquidDocsData.Models.SigningAuthority> pagedData = searchList;

        return pagedData;
    }

    private async Task DeleteRecordAsync(LiquidDocsData.Models.SigningAuthority r)
    {
        vm.RecordList.Remove(r);

        vm.ClearSelectionCommand.Execute(null);


        displaySigningAuthorityList = true;


        await OnSigningAuthorityComplete.InvokeAsync(vm.RecordList.ToList());

        StateHasChanged();


    }

    private void ClearSelection()
    {
        vm.ClearSelectionCommand.Execute(null);
        StateHasChanged();
    }

    private void AddRecordForEdit(LiquidDocsData.Models.SigningAuthority r)
    {
        vm.EditingRecord = r;

        searchString = "";

        AddButtonDisabled = true;

        StateHasChanged();
    }

    private void AddButton()
    {
        vm.AddButtonCommand.Execute(null);

        AddButtonDisabled = false;

        displaySigningAuthorityList = false;
    }

    private void AddAdditionalButton()
    {
        vm.AddButtonCommand.Execute(null);

        AddButtonDisabled = true;

        displaySigningAuthorityList = false;
    }

    private void OnSelectedRecord(LiquidDocsData.Models.SigningAuthority r)
    {

        if (r is not null) vm.SelectRecordCommand.Execute(r);

        displaySigningAuthorityList = false;

    }

    private async Task EditRecordAsync(LiquidDocsData.Models.SigningAuthority r)
    {
        OnSelectedRecord(r);

        displaySigningAuthorityList = false;

        StateHasChanged();

    }

    private void CancelEdit()
    {
        editingIndex = -1;

        StateHasChanged();
    }





}
